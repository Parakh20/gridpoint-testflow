# =============================================================================
# TestFlow — All Environment Variables Reference
# =============================================================================
# This root .env.example is a REFERENCE ONLY — it lists every variable used
# anywhere in the project with instructions on how to obtain each one.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  QUICK START                                                            │
# │  1. Frontend vars  → copy frontend/.env.example → frontend/.env        │
# │  2. CI secrets     → add to GitHub repo settings (see below)           │
# │  3. Edge fn secret → supabase secrets set ANTHROPIC_API_KEY=sk-ant-... │
# └─────────────────────────────────────────────────────────────────────────┘
# =============================================================================


# =============================================================================
# SECTION 1 — FRONTEND  (file: frontend/.env)
# =============================================================================
# Loaded by Vite. Inlined into the browser bundle. Must start with VITE_.
# See frontend/.env.example for the actual template.

# Supabase project URL
# → Supabase Dashboard → project → Settings → API → Project URL
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anon / public key  (safe to be public — RLS enforces security)
# → Supabase Dashboard → project → Settings → API → anon public
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Supabase project reference ID  (convenience reference — not used in code)
# → Supabase Dashboard → project → Settings → General → Reference ID
VITE_SUPABASE_PROJECT_ID=<project-ref>


# =============================================================================
# SECTION 2 — GITHUB ACTIONS SECRETS
# =============================================================================
# Add these at: GitHub repo → Settings → Secrets and variables → Actions
# These are NEVER stored in any .env file.

# Supabase personal access token (used by supabase CLI in CI)
# → https://supabase.com/dashboard → Account (top right) → Access Tokens → Generate new token
SUPABASE_ACCESS_TOKEN=sbp_...

# Supabase project reference ID (same value as VITE_SUPABASE_PROJECT_ID)
# → Supabase Dashboard → project → Settings → General → Reference ID
SUPABASE_PROJECT_ID=<project-ref>

# Supabase database password (used by supabase db push in CI)
# → Supabase Dashboard → project → Settings → Database → Database password
SUPABASE_DB_PASSWORD=<your-db-password>


# =============================================================================
# SECTION 3 — SUPABASE EDGE FUNCTION SECRETS  (server-side only)
# =============================================================================
# Set via CLI — NEVER add to any .env file.
# These run inside Supabase Edge Functions (Deno) and are never exposed to the browser.
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-api03-...
#
# Or via Supabase Dashboard → project → Edge Functions → Secrets

# Claude API key — used by the generate-report edge function
# → https://console.anthropic.com → API Keys → Create Key
# → Model in use: claude-haiku-4-5-20251001 (upgrade to claude-sonnet-4-6 for higher quality)
ANTHROPIC_API_KEY=sk-ant-api03-...


# =============================================================================
# SECTION 4 — LOCAL SUPABASE (optional, for local dev with supabase start)
# =============================================================================
# When running supabase start locally, output provides these values automatically.
# Replace frontend/.env with these when using the local stack:
#
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_PUBLISHABLE_KEY=<anon key from supabase start output>
