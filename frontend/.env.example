# =============================================================================
# TestFlow — Frontend Environment Variables
# =============================================================================
# Copy this file to .env inside the frontend/ directory.
#
#   cp frontend/.env.example frontend/.env
#
# These variables are inlined into the browser bundle by Vite at build time.
# They are PUBLIC — never put secret keys here (no service role key, no
# Anthropic key, no DB password).
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — required
# -----------------------------------------------------------------------------
# Project URL
#   Supabase Dashboard → your project → Settings → API → Project URL
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Anon / public key  (safe to expose — RLS enforces security)
#   Supabase Dashboard → your project → Settings → API → anon public
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Project reference ID  (convenience — not read by runtime code)
#   Supabase Dashboard → your project → Settings → General → Reference ID
VITE_SUPABASE_PROJECT_ID=<your-project-ref>


# -----------------------------------------------------------------------------
# Realtime kill-switch  (optional, default = enabled)
# -----------------------------------------------------------------------------
# Supabase Free tier caps realtime at 200 concurrent connections + 100 msgs/sec.
# If you're on Free and have >50 concurrent users, set this to "false" and the
# app will fall back to polling every 30s. Flip back to "true" when on Pro.
# Any value other than the string "false" is treated as enabled.
VITE_REALTIME_ENABLED=true


# -----------------------------------------------------------------------------
# Error monitoring  (optional)
# -----------------------------------------------------------------------------
# Sentry DSN. Until set, lib/monitoring.ts logs to console only.
# To activate fully: npm install @sentry/react in frontend/, then follow the
# SENTRY: comments in src/lib/monitoring.ts.
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>


# -----------------------------------------------------------------------------
# Platform Admin Panel — root domain (optimustesting.com) only
# -----------------------------------------------------------------------------
# REMOVED: VITE_PLATFORM_ADMIN_PASSWORD.
# The admin login used to ask for a client-side password AND the platform
# token. The password was checked in the browser, so it proved nothing to the
# server — only the token does. One field now. Delete the var from Vercel.

# REMOVED: VITE_PLATFORM_ADMIN_TOKEN.
# The X-Platform-Token value guards service-role Edge Functions (full RLS
# bypass: read every tenant, delete companies, mint magic links). A VITE_* var
# is inlined into the public JS bundle, and the same deployment serves every
# tenant subdomain — so shipping it there hands the platform to anyone who
# opens the admin chunk. The operator now types it at admin login and it is
# held in sessionStorage for that tab only (see pages/PlatformAdmin/platformToken.ts).
# Delete this variable from Vercel → Environment Variables if it is still set.
# Server side it is unchanged: supabase secrets set PLATFORM_ADMIN_TOKEN=<strong-value>
