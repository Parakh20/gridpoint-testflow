# =============================================================================
# TestFlow — Frontend Environment Variables
# =============================================================================
# Copy this file to .env inside the frontend/ directory.
#
#   cp frontend/.env.example frontend/.env
#
# These variables are inlined into the browser bundle by Vite at build time.
# They are PUBLIC — never put secret keys here (no service role key, no
# Anthropic key, no DB password).
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — required
# -----------------------------------------------------------------------------
# Project URL
#   Supabase Dashboard → your project → Settings → API → Project URL
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Anon / public key  (safe to expose — RLS enforces security)
#   Supabase Dashboard → your project → Settings → API → anon public
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Project reference ID  (convenience — not read by runtime code)
#   Supabase Dashboard → your project → Settings → General → Reference ID
VITE_SUPABASE_PROJECT_ID=<your-project-ref>
