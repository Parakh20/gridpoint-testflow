# Copy to load-test/.env and fill with your STAGING project's values.
# NEVER point this at production — the scripts refuse the prod ref unless ALLOW_PROD=1.

SUPABASE_URL=https://YOUR-STAGING-REF.supabase.co
SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# Seed sizing (optional overrides)
USERS=100
PROJECTS=20
RECORDS_PCT=40
QTY_PER_TYPE=3

# Realtime fan-out (optional)
CLIENTS=100
HOLD_SECONDS=60
